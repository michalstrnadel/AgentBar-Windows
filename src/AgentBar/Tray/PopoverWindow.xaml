<Window x:Class="AgentBar.Tray.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentBar" Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" AllowsTransparency="True"
        Background="Transparent" Topmost="True" Deactivated="OnDeactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3A3A3C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="10" Padding="10"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="AgentBar" Foreground="#8E8E93" FontSize="11"
                       FontWeight="SemiBold" Margin="4,0,0,8" />

            <!-- Pending approvals -->
            <ItemsControl x:Name="Approvals">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,2" CornerRadius="8"
                                Background="#3A2A17" BorderBrush="#FF9F0A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" Foreground="White"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ContextLines}" Margin="0,6,0,0"
                                              Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Gutter}" Foreground="{Binding GutterBrush}"
                                                           FontFamily="Consolas, Courier New" FontSize="11" Width="12" />
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}"
                                                           FontFamily="Consolas, Courier New" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="✓ Allow" Style="{StaticResource Pill}"
                                            Command="{Binding Choose}" CommandParameter="allow" />
                                    <Button Content="✓ Always" Style="{StaticResource Pill}"
                                            Command="{Binding Choose}" CommandParameter="always"
                                            ToolTip="{Binding RuleTooltip}"
                                            Visibility="{Binding HasRule, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="✕ Deny" Style="{StaticResource Pill}"
                                            Command="{Binding Choose}" CommandParameter="deny" />
                                    <Button Content="⌨ Defer" Style="{StaticResource Pill}"
                                            Command="{Binding Choose}" CommandParameter="defer"
                                            ToolTip="Answer in the terminal instead" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Live sessions -->
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="0,2" CornerRadius="6" Background="#2A2A2A">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding AgentName}" Foreground="White"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StateText}" Foreground="#9A9A9A"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SubText}" Foreground="#7A7A7A"
                                           FontSize="11" Margin="17,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Content="⌨ Approve in terminal" Style="{StaticResource Pill}"
                                        HorizontalAlignment="Left" Margin="17,6,0,0"
                                        Command="{Binding Keystroke}"
                                        Visibility="{Binding CanKeystroke, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Bring the terminal forward and send the approval keystroke (best-effort)" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyLabel" Text="No active agents"
                       Foreground="#7A7A7A" Margin="4,6" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
