<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AgentBar</AssemblyName>
    <RootNamespace>AgentBar</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <!-- Sprite frames embedded in the assembly (loaded via pack:// URIs), so they travel
       inside the single-file exe. Generated by scripts/extract-sprites.js. -->
  <ItemGroup>
    <Resource Include="Resources\sprites\**\*.png" />
  </ItemGroup>

  <!-- Ship the hook scripts next to the exe; HookInstaller copies them to ~/.agentbar/hooks. -->
  <ItemGroup>
    <Content Include="..\..\scripts\hooks\**\*.js"
             Link="hooks\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
